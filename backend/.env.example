# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file is gitignored and must NEVER be shared, screenshotted, or committed.

# Your Stripe TEST secret key — it starts with sk_test_
# Find it in the Stripe dashboard: Developers -> API keys -> Secret key (make sure you're in TEST mode).
# Keep using the TEST key the whole time we build. The live key (sk_live_) comes much later.
STRIPE_SECRET_KEY=sk_test_paste_your_test_key_here

# Your Anthropic (Claude) API key — powers the AI trip assistant. Starts with sk-ant-
# Get it from the Anthropic console: console.anthropic.com -> API keys.
# Without this, the assistant politely says "not switched on yet"; the rest of the app is fine.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Port the server listens on (optional; defaults to 4242).
PORT=4242

# --- Regions (backend/regions.js) ------------------------------------------------------------
# Each service region names its own servers; the plain variable is the fallback for every
# region. The region suffix is the region id upper-cased: fl-southeast -> FL_SOUTHEAST.
#
# OpenTripPlanner (infra/otp): transit planning for Smart Travel and, with no OSRM, the street
# routing behind the live map. Unset = http://localhost:8080.
# OTP_URL=http://localhost:8080
# OTP_URL_FL_SOUTHEAST=http://american-rider-otp:8080
#
# OSRM (optional): a street router of our own, same API as router.project-osrm.org — which the
# backend no longer calls; its policy forbids production use. Unset = route on OTP's street graph.
# OSRM_URL=
# OSRM_URL_FL_SOUTHEAST=

# HERE Routing API v8 key — server-side toll-cost authority. Never ship this key in the app.
# Coordinate-based Travel fails closed when toll cost cannot be verified.
HERE_API_KEY=

# Authenticates the external operational sweep endpoint. Required for external scheduler use.
SCHEDULER_TOKEN=

# Explicit server posture. Production disables demonstration fleet/screening relaxation even
# if a payment credential is accidentally test-mode; production attestation must also verify live providers.
DEPLOYMENT_MODE=development

# Required in production after the Florida TNC contingency policy is bound.
# State the actual platform-provided coverage types and limits from the policy/broker-approved disclosure.
TNC_INSURANCE_DISCLOSURE=
